# Create a Resend API key at https://resend.com/api-keys and keep the real value in .env.local.
RESEND_API_KEY=re_your_api_key

# This must be an email address/domain verified in your Resend account.
RESEND_FROM_EMAIL="Hope & Peter <rsvp@yourdomain.com>"

# Both inboxes that should receive every submitted RSVP (separate addresses with a comma).
RSVP_NOTIFICATION_EMAILS="first@yourdomain.com,second@yourdomain.com"

# Put your card in public/invitation-card/invitation-card.pdf. Change this only if
# you use a different name or format, such as invitation-card.png.
INVITATION_CARD_PATH=public/invitation-card/invitation-card.pdf
INVITATION_CARD_FILENAME=hope-and-peter-wedding-invitation.pdf

# Optional alternative: a public HTTPS URL to the card, used only when no local card exists.
# INVITATION_CARD_URL=https://yourdomain.com/invitation-card.pdf
